# Copy this file to ".env" and fill in the two required values. Never commit ".env".

# --- required ---------------------------------------------------------------
# Gemini API key (create one at https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key

# MongoDB Atlas connection string (Atlas > your cluster > Connect > Drivers).
# Replace <user> and <password>; URL-encode special characters in the password (e.g. @ becomes %40).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority

# --- optional (defaults shown) ----------------------------------------------
# MONGODB_DB=student_rag
# GEMINI_MODEL=gemini-2.5-flash
# EMBED_MODEL=gemini-embedding-001
# EMBED_DIM=768
# RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# MIN_RERANK_SCORE=-4.0
# MAX_PDF_MB=100
# MAX_PDF_PAGES=1500
